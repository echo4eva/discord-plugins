{
	"name": "discord-plugins",
	"version": "1.0.0",
	"description": "echo4eva's BetterDiscord plugins: ChungusTabs, ThreadNavigator, and CategoryAlerts",
	"type": "module",
	"scripts": {
		"dev": "node --watch lib/dev.ts",
		"build": "node lib/dev.ts --build",
		"build:tabs": "node lib/dev.ts --build --tabs",
		"build:threads": "node lib/dev.ts --build --thread-navigator",
		"build:alerts": "node lib/dev.ts --build --category-alerts",
		"format": "prettier --write ."
	},
	"maintainers": [
		{
			"name": "echo4eva"
		}
	],
	"license": "MIT",
	"devDependencies": {
		"@types/betterdiscord": "github:zerthox/betterdiscord-types",
		"@types/node": "^22.10.7",
		"esbuild": "^0.24.2",
		"prettier": "^3.4.2",
		"simple-git": "^3.27.0",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/echo4eva/discord-plugins"
	},
	"workspaces": [
		"Plugins/*"
	]
}
